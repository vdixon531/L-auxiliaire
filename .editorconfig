# Matches the existing style. There's no linter or formatter in this repo —
# no build step to hang one off — so this file is the only thing keeping
# whitespace consistent across editors.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Trailing double-space is a hard line break in Markdown.
trim_trailing_whitespace = false

# Vendored upstream code — not ours to reformat. See pdf-viewer/vendor/README.txt.
[pdf-viewer/vendor/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset

# Generated and source data. Large, machine-written, never hand-edited.
[data/**]
indent_style = unset
indent_size = unset
insert_final_newline = unset
