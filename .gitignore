.DS_Store
node_modules/

# Store package output (npm run package)
build/
*.log
.env
.vscode/

# Claude Code local settings — machine-specific paths and permission grants.
# A shared .claude/settings.json would be fine to commit; *.local.json is not.
.claude/settings.local.json

# Lexique raw download. Only the .tsv is read (by scripts/build-lexicon.js) and
# it is committed so `npm run build:lexicon` works from a clone. The .pdf and
# .xlsx are the same database in unused formats, ~37MB each.
scripts/lexique-source/*
!scripts/lexique-source/Lexique4.tsv
!scripts/lexique-source/README-Lexique.txt
