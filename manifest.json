{
  "manifest_version": 3,
  "name": "L'auxiliaire",
  "version": "0.1.0",
  "description": "Hover-translate, save vocabulary, view conjugations, and practice pronunciation for French learning.",

  "permissions": [
    "storage",
    "activeTab",
    "sidePanel",
    "alarms",
    "offscreen"
  ],

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content-script.js", "content/annotator.js"],
      "css": ["content/popup.css"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["<all_urls>"]
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "L'auxiliaire",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "commands": {
    "toggle-hover-translate": {
      "suggested_key": { "default": "Alt+T" },
      "description": "Toggle hover-to-translate mode"
    },
    "read-selection": {
      "suggested_key": { "default": "Alt+R" },
      "description": "Read selected text aloud"
    },
    "save-word": {
      "suggested_key": { "default": "Alt+S" },
      "description": "Save selected word to vocab"
    }
  },

  "minimum_chrome_version": "138"
}
